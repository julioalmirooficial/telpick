{
  "name": "telpick",
  "version": "2.1.0",
  "description": "Multi-platform country, phone code and timezone selectors (Telpick + TelpickZone) for React, Vue 3 and CDN with modern UI and IP detection.",
  "main": "dist/telpick.es.js",
  "module": "dist/telpick.es.js",
  "types": "dist/telpick.d.ts",
  "exports": {
    ".": {
      "import": "./dist/telpick.es.js",
      "require": "./dist/telpick.umd.js",
      "types": "./dist/telpick.d.ts"
    },
    "./vue": {
      "import": "./dist/telpick.vue.es.js",
      "types": "./dist/telpick.d.ts"
    },
    "./react": {
      "import": "./dist/telpick.react.es.js",
      "types": "./dist/telpick.d.ts"
    },
    "./vanilla": {
      "import": "./dist/telpick.es.js",
      "types": "./dist/telpick.d.ts"
    },
    "./zone": {
      "import": "./dist/telpick-zone.es.js",
      "require": "./dist/telpick-zone.umd.js",
      "types": "./dist/telpick.d.ts"
    },
    "./zone/react": {
      "import": "./dist/telpick-zone.react.es.js",
      "types": "./dist/telpick.d.ts"
    },
    "./zone/vue": {
      "import": "./dist/telpick-zone.vue.es.js",
      "types": "./dist/telpick.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./src/telpick.css": "./src/telpick.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.config.umd.js && vite build --config vite.config.zone.umd.js",
    "build:demo": "vite build --config vite.config.demo.js",
    "deploy:demo": "npm run build:demo && gh-pages -d docs",
    "dev": "vite",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julioalmirooficial/telpick.git"
  },
  "keywords": [
    "country",
    "phone",
    "selector",
    "country-selector",
    "phone-code",
    "dial-code",
    "vue",
    "react",
    "vanilla",
    "cdn",
    "telpick",
    "geolocation",
    "ip-detection",
    "timezone",
    "timezone-selector",
    "typescript"
  ],
  "author": {
    "name": "Julio Almiro",
    "email": "almiror.info@gmail.com",
    "url": "https://julioalmiro.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/julioalmirooficial/telpick/issues"
  },
  "homepage": "https://github.com/julioalmirooficial/telpick#readme",
  "peerDependencies": {
    "vue": ">=3.0.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "vite": "^5.4.0",
    "typescript": "^5.6.0",
    "vue": "^3.4.0",
    "react": "^18.3.0",
    "jest": "^29.7.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "minimatch": "^9.0.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
